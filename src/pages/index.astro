const recuerdos = [
  { codigo: "7.0", titulo: "Primera mirada", fecha: "", desc: "Ese segundo en el que todo cambio y aparecio esa chispa que ya no se fue.", imagen: "/images/record/image_copy_8.png" },
  { codigo: "7.1", titulo: "Primer abrazo", fecha: "", desc: "El momento exacto en que tus brazos se sintieron como mi lugar favorito.", imagen: "/images/record/image_copy_4.png" },
  { codigo: "7.2", titulo: "Primera salida", fecha: "", desc: "Nuestra primera aventura juntos, con nervios bonitos y sonrisas que lo dijeron todo.", imagen: "/images/record/image_copy_9.png" },
  { codigo: "7.3", titulo: "Primer beso", fecha: "", desc: "El beso que hizo que el mundo se quedara callado por un instante solo para nosotros.", imagen: "/images/record/image_copy_14.png" },
  { codigo: "7.4", titulo: "Primera cena", fecha: "", desc: "Compartir la mesa contigo hizo que hasta lo mas simple se sintiera especial.", imagen: "/images/record/image_copy_2.png" },
  { codigo: "7.5", titulo: "Primera matcha juntos", fecha: "", desc: "Una escena que me encanta recordar porque tu amor por el matcha tambien se volvio parte de mis recuerdos favoritos.", imagen: "/images/record/image_copy_11.png" },
  { codigo: "7.6", titulo: "Primera pelea", fecha: "48 horas sin dormir", desc: "Hasta los momentos dificiles me enseñan cuanto vales para mi y cuanto quiero aprender a cuidarnos mejor.", imagen: "/images/record/image_copy_6.png" },
  { codigo: "7.7", titulo: "Primera noche con un Four Loko", fecha: "", desc: "Una historia caotica, divertida y tan nuestra que siempre me sacara una sonrisa.", imagen: "/images/record/image_copy_12.png" },
  { codigo: "7.8", titulo: "Primer detalle", fecha: "14/06/2026", desc: "Ese detalle quedo marcado como una prueba bonita de todo lo que estamos construyendo.", imagen: "/images/record/image_copy.png" },
  { codigo: "7.9", titulo: "Primera tarde juntos", fecha: "15/06/2026", desc: "Una tarde completa contigo que guardo como un tesoro porque se sintio suave, bonita y muy nuestra.", imagen: "/images/record/image_copy_3.png" }
