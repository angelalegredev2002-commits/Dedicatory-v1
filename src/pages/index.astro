      <div class="relative w-full group">
        <!-- Contenedor scrollable -->
        <div id="foto-carrusel" class="flex gap-6 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-8 px-4" style="scroll-behavior: smooth;">
          
          {fotos.length === 0 ? (
