    <!-- Decorative background blobs -->
    <div class="absolute top-1/2 right-1/4 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl -z-10 mix-blend-screen pointer-events-none"></div>
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-white text-center mb-4 flex items-center justify-center gap-3">
