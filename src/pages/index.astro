      </p>

      <!-- Contenedor del Mapa con Lineamiento -->
      <div class="adventure-path-container">
        <!-- Línea discontinua que conecta todos los hitos del mapa -->
        <div class="adventure-trail-line"></div>
        {locuras.map((locura, index) => (
          <div class="adventure-path-row">
            <div class="adventure-path-node">{index + 1}</div>
            <div class="adventure-card group" onclick="toggleAdventure(this)">
              <div class="heart-checkbox">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
                </svg>
              </div>
              <span class="adventure-badge">Pendiente bonito ✦</span>
              <div class="adventure-icon">
                {index === 0 && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75c4.5-5.25 15-5.25 19.5 0M4.5 15c3.75-4.5 11.25-4.5 15 0M7.5 11.25c2.25-2.25 6.75-2.25 9 0"/>
                  </svg>
                )}
                {index === 1 && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3v9M9 9v8.25m0-8.25L3.75 10.5v7.5M9 17.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0Zm10.5-2.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0Z"/>
                  </svg>
                )}
                {index === 2 && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 18.75h18M4.5 18.75V9.375l7.5-3.375 7.5 3.375v9.375M9 18.75v-4.5h6v4.5"/>
                  </svg>
                )}
                {index === 3 && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 6.75v10.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 17.25V6.75m15 0A2.25 2.25 0 0017.25 4.5H6.75A2.25 2.25 0 004.5 6.75m15 0L12 12 4.5 6.75"/>
                  </svg>
                )}
              </div>
              <p class="text-[11px] uppercase tracking-[0.26em] text-gray-400 mb-3">{locura.nota}</p>
              <h4 class="adventure-title">{locura.titulo}</h4>
              <p class="adventure-desc">{locura.desc}</p>
            </div>
          </div>
        ))}

        <!-- End of map glowing message -->
        <div class="mt-14 flex flex-col items-center justify-center text-center px-4 relative">
          <!-- Decorative path continuation -->
          <div class="absolute -top-12 left-1/2 w-0.5 h-12 bg-gradient-to-b from-rose-500/30 to-transparent dashed-line"></div>
          <div class="w-14 h-14 rounded-full bg-purple-500/20 flex items-center justify-center mb-4 animate-pulse shadow-[0_0_20px_#f472b6]">
            <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
            </svg>
          </div>
          <h4 class="text-lg font-bold text-white mb-2">Y el mapa sigue...</h4>
          <p class="text-purple-200/90 text-[13px] md:text-sm max-w-md italic font-serif leading-relaxed">
            Cada plan que salga de esta lista va a dejar espacio para el siguiente. Contigo siempre habra una locura nueva para tachar juntos.
          </p>
        </div>

      </div>
    </div>
  </section>

