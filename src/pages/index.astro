---

<Layout title={`Para ${dedicatoria.para}`} description="Una dedicatoria especial con amor">

  <!-- ══ HEADER DINÁMICO ══ -->
  <header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-500 translate-y-0">
    <div class="mx-auto max-w-5xl flex items-center justify-between px-6 py-4">
      <!-- Navegación -->
      <nav class="flex items-center gap-4 sm:gap-6 text-[11px] uppercase tracking-[0.2em] text-white/60 font-medium">
        <button id="btn-nav-carta" class="hover:text-rose-400 text-rose-300 flex items-center gap-1.5 transition-colors cursor-pointer bg-transparent border-0 p-0 text-[11px] uppercase tracking-[0.2em]">
          <svg class="w-3.5 h-3.5 text-rose-400 animate-pulse" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5H4.5a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
          <span>Carta</span>
        </button>
        <a href="#unmes" class="hover:text-rose-400 transition-colors text-rose-400/70 hidden sm:inline-block">1 Mes ♥</a>
        <a href="#melodia" class="hover:text-white transition-colors hidden md:inline-block">Melodía</a>
        <a href="#recuerdos" class="hover:text-white transition-colors hidden md:inline-block">Recuerdos</a>
        <a href="#fotos" class="hover:text-white transition-colors hidden md:inline-block">Fotos</a>
      </nav>

      <!-- Botón Icono Carta del Lateral en Header -->
      <div class="flex items-center gap-3">
        <button
          id="btn-abrir-carta-header"
          class="group inline-flex items-center gap-2 rounded-full border border-rose-400/40 bg-gradient-to-r from-rose-500/20 to-fuchsia-500/20 px-3.5 py-1.5 text-xs font-semibold text-white hover:from-rose-500/40 hover:to-fuchsia-500/40 hover:border-rose-400/70 transition-all duration-300 hover:scale-105 shadow-[0_0_15px_rgba(244,114,182,0.25)] cursor-pointer"
        >
          <span class="w-5 h-5 rounded-full bg-rose-500/30 flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-3 h-3 text-rose-200" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </span>
          <span class="tracking-wide">Abrir Cartita</span>
        </button>
        <span class="text-[10px] uppercase tracking-[0.2em] text-rose-400/70 hidden lg:block">24 · jun · 2026</span>
      </div>
    </div>
  </header>

  <!-- ══ FONDO: Letras flotantes ══ -->
  <div id="flotantes" class="fixed inset-0 overflow-hidden pointer-events-none z-0"></div>

  <!-- ══ HERO ══ -->
  <section class="relative z-10 flex min-h-[78vh] flex-col items-center justify-center px-6 pt-20 pb-12 text-center md:min-h-[88vh]">
    <p class="text-purple-400 text-[11px] font-light tracking-[0.38em] uppercase mb-4 flex items-center gap-2 justify-center">
      <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 4.8 5.6.8-4 4 1 5.4-5-2.8-5 2.8 1-5.4-4-4 5.6-.8z"/></svg>
      Un rinconcito de amor solo para ti
      <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 4.8 5.6.8-4 4 1 5.4-5-2.8-5 2.8 1-5.4-4-4 5.6-.8z"/></svg>
    </p>
    <h1 class="glow-text font-black leading-[0.95] mb-4 flex flex-col items-center justify-center">
      <span class="text-white text-4xl md:text-6xl mb-2">Para ti, mi amor</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-fuchsia-400 to-pink-400 text-6xl md:text-[8rem] leading-none">
        {dedicatoria.para}
      </span>
    </h1>
    <p class="max-w-2xl text-sm md:text-base text-gray-300 leading-relaxed">
      Ordene este espacio para que cada parte de nosotros se sienta mas cerquita: la carta, la melodia, nuestros recuerdos y todo lo que todavia nos falta vivir.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.25em] text-gray-200">
        {dedicatoria.de}
      </span>
      <span class="rounded-full border border-fuchsia-500/20 bg-fuchsia-500/10 px-4 py-2 text-xs uppercase tracking-[0.25em] text-fuchsia-200">
        Desde el {hitosCamino[0].fecha}
      </span>
    </div>

    <!-- Botón Video Especial al Inicio -->
    <div class="mt-8">
      <button
        class="btn-abrir-video group inline-flex items-center gap-3 rounded-full bg-gradient-to-r from-rose-500/20 via-fuchsia-500/20 to-purple-500/20 border border-rose-400/40 px-6 py-3.5 text-sm text-white font-semibold tracking-wide hover:from-rose-500/40 hover:via-fuchsia-500/40 hover:to-purple-500/40 hover:border-rose-400/70 transition-all duration-300 hover:scale-105 shadow-[0_0_25px_rgba(244,114,182,0.3)] cursor-pointer"
      >
        <span class="w-8 h-8 rounded-full bg-rose-500/30 border border-rose-400/50 flex items-center justify-center group-hover:bg-rose-500/60 transition-colors shadow-inner">
          <svg class="w-4 h-4 text-rose-200 translate-x-[1px]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </span>
        <span>Ver nuestro video especial</span>
        <svg class="w-4 h-4 text-rose-300 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.72-4.72a.75.75 0 011.28.53v11.38a.75.75 0 01-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 002.25-2.25v-9a2.25 2.25 0 00-2.25-2.25h-9A2.25 2.25 0 002.25 7.5v9a2.25 2.25 0 002.25 2.25z"/>
        </svg>
      </button>
    </div>

    <div class="mt-12 flex flex-col items-center gap-2 text-gray-500 text-sm animate-bounce">
      <span>Desliza hacia abajo pliss</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- ══ BANNER PRINCIPAL ══ -->
  <section class="relative z-10 w-full px-4 md:px-8 -mt-4 mb-12">
    <div class="max-w-6xl mx-auto relative rounded-3xl overflow-hidden shadow-2xl shadow-purple-900/30 border border-white/10">
      <!-- Imagen grande -->
      <img
        src="/images/record/image_copy_13.png"
        alt="Nuestra historia juntos"
        class="w-full h-[320px] md:h-[480px] lg:h-[560px] object-cover"
        loading="eager"
      />
      <!-- Overlay degradado con texto -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col items-center justify-end pb-8 md:pb-12 px-6">
        <p class="text-white/90 text-sm md:text-lg font-light tracking-wide text-center max-w-2xl leading-relaxed mb-3">
          Con todo mi corazón
        </p>
        <p class="text-transparent bg-clip-text bg-gradient-to-r from-purple-300 via-fuchsia-300 to-pink-300 text-xs md:text-sm uppercase tracking-[0.3em] font-semibold">
          Día de novios • 24 de junio de 2026
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="w-8 h-[1px] bg-gradient-to-r from-transparent to-fuchsia-400"></span>
          <svg class="w-4 h-4 text-fuchsia-400 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
          <span class="w-8 h-[1px] bg-gradient-to-l from-transparent to-fuchsia-400"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ DRAWER / PANEL LATERAL DE LA CARTA ══ -->
  <div id="carta-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[200] opacity-0 pointer-events-none transition-opacity duration-500"></div>

  <aside id="carta-drawer" class="fixed top-0 right-0 z-[210] h-full w-full max-w-md md:max-w-lg bg-[#090314]/98 border-l border-rose-400/25 backdrop-blur-2xl shadow-2xl p-6 md:p-8 translate-x-full transition-transform duration-500 ease-out flex flex-col justify-between overflow-y-auto">
    <div>
      <!-- Header del Drawer -->
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-rose-500/20 border border-rose-400/40 flex items-center justify-center text-rose-300">
            <svg class="w-4.5 h-4.5 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>
          <div>
            <p class="text-[10px] uppercase tracking-[0.3em] text-rose-400 font-semibold">Cartita Especial</p>
            <h3 class="text-white font-bold text-base md:text-lg">Para ti, mi amor {dedicatoria.para} 🌹</h3>
          </div>
        </div>

        <button id="btn-cerrar-carta-drawer" class="w-9 h-9 rounded-full bg-white/10 border border-white/10 text-white flex items-center justify-center hover:bg-rose-500/30 hover:border-rose-400/40 transition-all cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Contenido de la carta -->
      <div class="space-y-5">
        <!-- Imagen destacada -->
        <div class="relative rounded-2xl overflow-hidden border border-white/10 shadow-xl">
          <img src="/images/record/image_copy_13.png" alt="Nuestra carta" class="w-full h-44 object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-4">
            <span class="text-[10px] uppercase tracking-[0.25em] text-purple-300">Con todo mi corazón</span>
          </div>
        </div>

        <!-- Mensaje escrito -->
        <div class="relative bg-white/5 border border-white/10 rounded-2xl p-5 md:p-6 backdrop-blur-md">
          <span class="text-rose-400 text-3xl font-serif block -mb-1">❝</span>
          <p class="text-gray-200 text-sm md:text-base leading-relaxed whitespace-pre-line font-serif italic">
            {dedicatoria.mensaje}
          </p>
          <span class="text-rose-400 text-3xl font-serif block text-right -mt-1">❞</span>
        </div>
      </div>
    </div>

    <!-- Footer del Drawer -->
    <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-[11px] text-gray-400">
      <span class="uppercase tracking-[0.2em]">{dedicatoria.de}</span>
      <button id="btn-cerrar-carta-drawer-foot" class="px-4 py-2 rounded-full bg-white/10 hover:bg-rose-500/30 text-white text-xs font-semibold uppercase tracking-wider transition-colors cursor-pointer">
        Cerrar cartita
      </button>
    </div>
  </aside>

  <!-- ══ LÍNEA DEL TIEMPO DE NUESTROS MOMENTOS ══ -->
  <section id="recuerdos" class="relative z-10 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-white text-center mb-4 flex items-center justify-center gap-3">
        <!-- SVG History icon -->
        <svg class="w-7 h-7 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        El camino que estamos dibujando...
      </h2>
