    window.addEventListener('scroll', updateScroll, { passive: true });
    window.addEventListener('resize', updateScroll, { passive: true });
    updateScroll();
  })();

  // --- Toggle de tarjeta de locura (marcar como cumplida) ---
  function toggleLocuraCard(card) {
    const isDone = card.classList.toggle('locura-done');
    const checkEmpty = card.querySelector('.locura-check-empty');
    const checkDone  = card.querySelector('.locura-check-done');
    const titleEl    = card.querySelector('.locura-card-title');
    const promptEl   = card.querySelector('.locura-prompt-text');

    if (isDone) {
      if (checkEmpty) checkEmpty.classList.add('hidden');
      if (checkDone)  checkDone.classList.remove('hidden');
      if (titleEl) {
        titleEl.style.textDecoration = 'line-through';
        titleEl.style.opacity = '0.5';
      }
      if (promptEl) promptEl.textContent = '¡Cumplido juntos! ✨';
      card.style.borderColor = 'rgba(74, 222, 128, 0.4)';
      card.style.background  = 'rgba(34, 197, 94, 0.12)';

      // Confeti de corazones
      for (let i = 0; i < 15; i++) {
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-50 text-emerald-400';
        const rect = card.getBoundingClientRect();
        heart.style.left = `${rect.left + rect.width / 2 + (Math.random() - 0.5) * 140}px`;
        heart.style.top  = `${rect.top  + rect.height / 2 + (Math.random() - 0.5) * 140}px`;
        heart.innerHTML  = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
        document.body.appendChild(heart);
        heart.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 1 },
          { transform: `translate(${(Math.random() - 0.5) * 200}px, ${-120 - Math.random() * 80}px) scale(1.6)`, opacity: 0 }
        ], { duration: 1200, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' });
        setTimeout(() => heart.remove(), 1200);
      }
    } else {
      if (checkEmpty) checkEmpty.classList.remove('hidden');
      if (checkDone)  checkDone.classList.add('hidden');
      if (titleEl) {
        titleEl.style.textDecoration = '';
        titleEl.style.opacity = '';
      }
      if (promptEl) promptEl.textContent = 'Toca para tachar';
      card.style.borderColor = '';
      card.style.background  = '';
    }

    // Actualizar contador y barra de progreso
    const allCards  = document.querySelectorAll('.locura-card');
    const doneCards = document.querySelectorAll('.locura-card.locura-done');
    const label     = document.getElementById('locuras-count-label');
    const fillBar   = document.getElementById('locuras-bar-fill');
    if (label && fillBar) {
      label.textContent = `${doneCards.length} / ${allCards.length} locuras cumplidas`;
      fillBar.style.width = `${(doneCards.length / allCards.length) * 100}%`;
    }
  }

  // --- Lógica del Carrusel de Fotos ---
  const carrusel = document.getElementById('foto-carrusel');
  const btnCarruselPrev = document.getElementById('btn-carrusel-prev');
  const btnCarruselNext = document.getElementById('btn-carrusel-next');
  const recuerdosCarrusel = document.getElementById('recuerdos-carrusel');
  const btnRecuerdosPrev = document.getElementById('btn-recuerdos-prev');
  const btnRecuerdosNext = document.getElementById('btn-recuerdos-next');
  const recuerdosCounter = document.getElementById('recuerdos-counter');

  if (recuerdosCarrusel && btnRecuerdosPrev && btnRecuerdosNext && recuerdosCounter) {
    const cards = Array.from(recuerdosCarrusel.querySelectorAll('.memory-banner'));

    const getCardStep = () => {
      const firstCard = cards[0];
      if (!firstCard) return 320;
      const styles = window.getComputedStyle(recuerdosCarrusel);
      const gap = parseFloat(styles.columnGap || styles.gap || '16');
      return firstCard.getBoundingClientRect().width + gap;
    };

    const updateRecuerdosState = () => {
      const step = getCardStep();
      const index = Math.max(0, Math.min(cards.length - 1, Math.round(recuerdosCarrusel.scrollLeft / step)));
      recuerdosCounter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      btnRecuerdosPrev.disabled = index === 0;
      btnRecuerdosNext.disabled = index >= cards.length - 1;
      btnRecuerdosPrev.style.opacity = btnRecuerdosPrev.disabled ? '0.45' : '1';
      btnRecuerdosNext.style.opacity = btnRecuerdosNext.disabled ? '0.45' : '1';
    };

    btnRecuerdosPrev.addEventListener('click', () => {
      recuerdosCarrusel.scrollBy({ left: -getCardStep(), behavior: 'smooth' });
    });

    btnRecuerdosNext.addEventListener('click', () => {
      recuerdosCarrusel.scrollBy({ left: getCardStep(), behavior: 'smooth' });
    });

    recuerdosCarrusel.addEventListener('scroll', updateRecuerdosState);
    window.addEventListener('resize', updateRecuerdosState);
    setTimeout(updateRecuerdosState, 120);
  }

  if (carrusel && btnCarruselPrev && btnCarruselNext) {
    const scrollAmount = 320; // Aproximadamente el ancho de una tarjeta
    
    // Función para actualizar estado de botones
    const updateButtons = () => {
      btnCarruselPrev.disabled = carrusel.scrollLeft <= 0;
      btnCarruselNext.disabled = Math.ceil(carrusel.scrollLeft) >= (carrusel.scrollWidth - carrusel.clientWidth - 10);
      
      btnCarruselPrev.style.opacity = btnCarruselPrev.disabled ? '0' : '';
      btnCarruselNext.style.opacity = btnCarruselNext.disabled ? '0' : '';
    };

    btnCarruselPrev.addEventListener('click', () => {
      carrusel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnCarruselNext.addEventListener('click', () => {
      carrusel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    carrusel.addEventListener('scroll', updateButtons);
    // Inicializar estado
    setTimeout(updateButtons, 100);
    window.addEventListener('resize', updateButtons);
  }

  // --- Lógica Propuesta de Noviazgo ---
  const btnNo = document.getElementById('btn-no');
  const btnSi = document.getElementById('btn-si');
  const propuestaContent = document.getElementById('propuesta-content');
  const propuestaSuccess = document.getElementById('propuesta-success');
  const propuestaContainer = document.getElementById('propuesta-container');

  if (btnNo && btnSi) {
    // Hacer que el botón "No" huya del cursor
    const moveBtnNo = () => {
      const maxX = 150;
      const maxY = 100;
      
      const newX = (Math.random() - 0.5) * maxX * 2;
      const newY = (Math.random() - 0.5) * maxY * 2;
      
      btnNo.style.position = 'absolute';
      btnNo.style.transform = `translate(${newX}px, ${newY}px)`;
    };

    btnNo.addEventListener('mouseover', moveBtnNo);
    btnNo.addEventListener('touchstart', moveBtnNo);

    // Cuando dice que SÍ
    btnSi.addEventListener('click', () => {
      // Ocultar la pregunta
      propuestaContent.style.display = 'none';
      
      // Mostrar el mensaje de éxito
      propuestaSuccess.classList.remove('hidden');
      propuestaSuccess.classList.add('flex');
      
      // Cambiar fondo del contenedor
      propuestaContainer.classList.add('bg-rose-900/40', 'border-rose-500/50');
      
      // Animación de aparición
      setTimeout(() => {
        propuestaSuccess.classList.remove('opacity-0');
        propuestaSuccess.classList.add('opacity-100');
      }, 50);

      // Lluvia de corazones explosiva
      for(let i=0; i<60; i++) {
        setTimeout(() => {
          const heart = document.createElement('div');
          heart.className = 'fixed pointer-events-none z-50 text-rose-500';
          heart.style.left = '50%';
          heart.style.top = '50%';
          heart.innerHTML = `<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
          document.body.appendChild(heart);
          
          const angle = Math.random() * Math.PI * 2;
          const velocity = 100 + Math.random() * 500;
          const xOffset = Math.cos(angle) * velocity;
          const yOffset = Math.sin(angle) * velocity;
          
          heart.animate([
            { transform: 'translate(-50%, -50%) scale(0.5) rotate(0deg)', opacity: 1 },
            { transform: `translate(calc(-50% + ${xOffset}px), calc(-50% + ${yOffset}px)) scale(2) rotate(${Math.random() * 360}deg)`, opacity: 0 }
          ], { duration: 1500 + Math.random() * 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' });
          
          setTimeout(() => heart.remove(), 3000);
        }, i * 20);
      }
    });
  }

  // --- Header dinámico: ocultar al bajar, mostrar al subir, blur al hacer scroll ---
  const header = document.getElementById('site-header');
  let lastScrollY = window.scrollY;

  const updateHeader = () => {
    const currentScrollY = window.scrollY;
    const scrolledDown = currentScrollY > lastScrollY;
    const pastThreshold = currentScrollY > 60;

    // Fondo blur/sólido cuando no está en el top
    if (pastThreshold) {
      header.style.background = 'rgba(5,2,15,0.75)';
      header.style.backdropFilter = 'blur(16px)';
      header.style.boxShadow = '0 1px 0 rgba(255,255,255,0.05)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.boxShadow = 'none';
    }

    // Ocultar al bajar, mostrar al subir
    if (scrolledDown && pastThreshold) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }

    lastScrollY = currentScrollY;
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // ───────────────────────────────────────────
  // SECCIÓN 1 MES — CARRUSEL CINEMATOGRÁFICO
  // ───────────────────────────────────────────
  (function() {
    var fotosUnMes = [
      { src: '/images/1month/1mesaniversaritortanoche.png',           caption: 'La noche de nuestro primer mes', side: 'right' },
      { src: '/images/1month/ellaconmigoselfie.png',                  caption: 'Esa selfie que guardo en el corazón', side: 'left' },
      { src: '/images/1month/elladedicacorazoncondedos.png',          caption: 'Tu corazón con los dedos', side: 'right' },
      { src: '/images/1month/elladedicafotoencuadriplecorazonbar.png', caption: 'Esa noche en el bar llena de amor', side: 'left' },
      { src: '/images/1month/elladurmiendo.png',                      caption: 'Dormida y tan hermosa', side: 'right' },
      { src: '/images/1month/ellaenbar2.png',                         caption: 'Tú en el bar, brillando', side: 'left' },
      { src: '/images/1month/ellaenbar3.png',                         caption: 'Una noche que no olvidaré', side: 'right' },
      { src: '/images/1month/ellaenbarfoto.png',                      caption: 'Tu foto favorita del bar', side: 'left' },
      { src: '/images/1month/ellaenelcarroconsuramo.png',             caption: 'Con tu ramo de rosas en el carro', side: 'right' },
      { src: '/images/1month/ellajuntosdelamano.png',                 caption: 'De la mano y sin soltarte', side: 'left' },
      { src: '/images/1month/ellamiradaangelical.png',                caption: 'Tu mirada que me roba el alma', side: 'right' },
      { src: '/images/1month/ellaramoderosaskitty.png',               caption: 'Tu ramo de rosas Kitty', side: 'left' },
      { src: '/images/1month/ellatierna.png',                         caption: 'Tan tierna que me derrites', side: 'right' },
      { src: '/images/1month/ellaunabrazoensuhombro.png',             caption: 'Mi lugar favorito: tu hombro', side: 'left' },
      { src: '/images/1month/ellaunafotodenoche.png',                 caption: 'Una noche contigo, perfecta', side: 'right' },
      { src: '/images/1month/primerafotojuntosnoche.png',             caption: 'Nuestra primera foto juntos de noche', side: 'left' },
    ];

    var cineTrack        = document.getElementById('cine-track');
    var cineDots         = document.getElementById('cine-dots');
    var cinePrev         = document.getElementById('cine-prev');
    var cineNext         = document.getElementById('cine-next');
    var cineProgresoFill = document.getElementById('cine-progreso-fill');
    if (!cineTrack) return;

    var cineIdx       = 0;
    var cineAutoTimer = null;
    var cineAnimating = false;
    var CINE_INTERVAL = 4500;

    // Construir tarjetas
    fotosUnMes.forEach(function(foto, index) {
      var isLeft = foto.side === 'left';
      var card = document.createElement('div');
      card.className = 'cine-card';
      card.dataset.index = index;
      card.style.cssText = 'display:none; opacity:0;';

      var numLabel = String(index + 1).padStart(2,'0') + ' / ' + String(fotosUnMes.length).padStart(2,'0');
      var badgePos = isLeft ? 'right:1rem;' : 'left:1rem;';
      var flexDir  = isLeft ? 'flex-direction:row;' : 'flex-direction:row-reverse;';
      var textAlign = isLeft ? 'text-align:left;' : 'text-align:right;';
      var lineDir  = isLeft ? 'from-rose-400/60 to-transparent' : 'from-transparent to-rose-400/60';
      var justifyItems = isLeft ? 'justify-content:flex-start;' : 'justify-content:flex-end;';

      card.innerHTML =
        '<div class="cine-inner" style="display:flex;flex-wrap:wrap;gap:2rem;align-items:center;' + flexDir + '">' +

          // Imagen
          '<div style="position:relative;flex:1 1 340px;max-width:520px;border-radius:28px;overflow:hidden;border:1px solid rgba(255,255,255,0.1);box-shadow:0 25px 60px rgba(0,0,0,0.5);">' +
            '<img src="' + foto.src + '" alt="' + foto.caption + '" loading="lazy" ' +
              'style="width:100%;aspect-ratio:3/4;object-fit:cover;display:block;transition:transform 0.7s ease;" ' +
              'onmouseover="this.style.transform=\'scale(1.04)\'" ' +
              'onmouseout="this.style.transform=\'scale(1)\'" ' +
            '/>' +
            '<div style="position:absolute;inset:0;background:linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 50%);"></div>' +
            '<div style="position:absolute;top:1rem;' + badgePos + 'background:rgba(0,0,0,0.55);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.12);border-radius:99px;padding:0.25rem 0.75rem;display:flex;align-items:center;gap:0.5rem;">' +
              '<div style="width:6px;height:6px;border-radius:99px;background:#fb7185;animation:pulse 2s infinite;"></div>' +
              '<span style="font-size:10px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:white;">' + numLabel + '</span>' +
            '</div>' +
          '</div>' +

          // Texto
          '<div style="flex:1 1 240px;max-width:320px;' + textAlign + '">' +
            '<p style="font-size:10px;letter-spacing:0.35em;text-transform:uppercase;color:#fb7185;margin-bottom:1rem;display:flex;align-items:center;gap:0.5rem;' + justifyItems + '">' +
              '<svg width="12" height="12" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>' +
              'Recuerdo' +
            '</p>' +
            '<h3 style="color:white;font-weight:900;font-size:clamp(1.5rem,3vw,2.5rem);line-height:1.1;font-style:italic;font-family:serif;margin-bottom:1.25rem;">' +
              '\u201C' + foto.caption + '\u201D' +
            '</h3>' +
            '<div style="display:inline-flex;align-items:center;gap:0.5rem;border:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);border-radius:99px;padding:0.4rem 1rem;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(156,163,175,1);">' +
              '1 mes juntos' +
              '<span style="width:4px;height:4px;border-radius:99px;background:#fb7185;display:inline-block;"></span>' +
              'Mayo 2026' +
            '</div>' +
            '<div style="margin-top:1.5rem;display:flex;align-items:center;gap:0.75rem;' + justifyItems + '">' +
              '<span style="width:40px;height:1px;background:linear-gradient(to right, rgba(251,113,133,0.6), transparent);' + (isLeft ? '' : 'transform:scaleX(-1);') + '"></span>' +
              '<svg width="16" height="16" fill="none" stroke="rgba(251,113,133,0.5)" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2l2.4 4.8 5.6.8-4 4 1 5.4-5-2.8-5 2.8 1-5.4-4-4 5.6-.8z"/></svg>' +
              '<span style="width:40px;height:1px;background:linear-gradient(to left, rgba(251,113,133,0.6), transparent);' + (isLeft ? '' : 'transform:scaleX(-1);') + '"></span>' +
            '</div>' +
          '</div>' +

        '</div>';

      cineTrack.appendChild(card);
    });

    // Crear dots
    var allCards = cineTrack.querySelectorAll('.cine-card');
    var allDots  = [];
    fotosUnMes.forEach(function(_, i) {
      var dot = document.createElement('button');
      dot.style.cssText = 'width:6px;height:6px;border-radius:99px;background:rgba(255,255,255,0.2);border:none;cursor:pointer;transition:all 0.3s;padding:0;';
      dot.addEventListener('click', function() { irACine(i); });
      if (cineDots) cineDots.appendChild(dot);
      allDots.push(dot);
    });

    function updateDots(index) {
      allDots.forEach(function(d, i) {
        d.style.width  = i === index ? '16px' : '6px';
        d.style.background = i === index ? '#fb7185' : 'rgba(255,255,255,0.2)';
      });
    }

    function mostrarCine(index, direction) {
      if (cineAnimating) return;
      cineAnimating = true;

      var currentCard = null;
      allCards.forEach(function(c) { if (c.style.display !== 'none') currentCard = c; });
      var nextCard = allCards[index];

      updateDots(index);
      var enterFrom = direction === 'next' ? '60px' : '-60px';
      var exitTo    = direction === 'next' ? '-60px' : '60px';

      function showNext() {
        nextCard.style.display = 'block';
        nextCard.style.opacity = '0';
        nextCard.style.transform = 'translateX(' + enterFrom + ')';
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            nextCard.style.transition = 'opacity 0.5s cubic-bezier(0.22,1,0.36,1), transform 0.5s cubic-bezier(0.22,1,0.36,1)';
            nextCard.style.opacity = '1';
            nextCard.style.transform = 'translateX(0)';
            setTimeout(function() {
              nextCard.style.transition = '';
              cineAnimating = false;
            }, 520);
          });
        });
      }

      if (currentCard && currentCard !== nextCard) {
        currentCard.style.transition = 'opacity 0.35s ease-in, transform 0.35s ease-in';
        currentCard.style.opacity = '0';
        currentCard.style.transform = 'translateX(' + exitTo + ')';
        setTimeout(function() {
          currentCard.style.display = 'none';
          currentCard.style.transition = '';
          currentCard.style.transform = 'translateX(0)';
          showNext();
        }, 370);
      } else {
        if (currentCard) currentCard.style.display = 'none';
        showNext();
      }

      cineIdx = index;
      resetProgreso();
    }

    function irACine(index) {
      var dir = index >= cineIdx ? 'next' : 'prev';
      mostrarCine(index, dir);
      reiniciarAutoplay();
    }

    // Barra de progreso
    function resetProgreso() {
      if (!cineProgresoFill) return;
      cineProgresoFill.style.transition = 'none';
      cineProgresoFill.style.width = '0%';
      setTimeout(function() {
        cineProgresoFill.style.transition = 'width ' + CINE_INTERVAL + 'ms linear';
        cineProgresoFill.style.width = '100%';
      }, 30);
    }

    function iniciarAutoplay() {
      clearInterval(cineAutoTimer);
      cineAutoTimer = setInterval(function() {
        var next = (cineIdx + 1) % fotosUnMes.length;
        mostrarCine(next, 'next');
      }, CINE_INTERVAL);
      resetProgreso();
    }

    function reiniciarAutoplay() {
      clearInterval(cineAutoTimer);
      iniciarAutoplay();
    }

    if (cinePrev) cinePrev.addEventListener('click', function() {
      var prev = (cineIdx - 1 + fotosUnMes.length) % fotosUnMes.length;
      mostrarCine(prev, 'prev');
      reiniciarAutoplay();
    });
    if (cineNext) cineNext.addEventListener('click', function() {
      var next = (cineIdx + 1) % fotosUnMes.length;
      mostrarCine(next, 'next');
      reiniciarAutoplay();
    });

    // Swipe táctil
    var swipeStartX = 0;
    cineTrack.addEventListener('touchstart', function(e) { swipeStartX = e.touches[0].clientX; }, { passive: true });
    cineTrack.addEventListener('touchend', function(e) {
      var diff = swipeStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        var next = diff > 0
          ? (cineIdx + 1) % fotosUnMes.length
          : (cineIdx - 1 + fotosUnMes.length) % fotosUnMes.length;
        mostrarCine(next, diff > 0 ? 'next' : 'prev');
        reiniciarAutoplay();
      }
    }, { passive: true });

    // Arrancar
    mostrarCine(0, 'next');
    iniciarAutoplay();

    // ── MODAL DE VIDEO ──────────────────────────
    var modalVideo   = document.getElementById('modal-video');
    var modalPlayer  = document.getElementById('modal-video-player');
    var btnsAbrir    = document.querySelectorAll('.btn-abrir-video');

    window.cerrarVideoModal = function() {
      if (!modalVideo) return;
      if (modalPlayer) modalPlayer.pause();
      modalVideo.style.display = 'none';
      document.body.style.overflow = '';
    };

    btnsAbrir.forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (!modalVideo) return;
        modalVideo.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        setTimeout(function() {
          if (modalPlayer) modalPlayer.play().catch(function(){});
        }, 200);
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalVideo && modalVideo.style.display === 'flex') {
        window.cerrarVideoModal();
      }
    });
  })();

  // --- Toggle de vale (marcar como canjeado) ---
  function toggleVale(card) {
    const isClaimed = card.classList.toggle('vale-claimed');
    const iconUnclaimed = card.querySelector('.vale-icon-unclaimed');
    const iconClaimed   = card.querySelector('.vale-icon-claimed');
    const titleEl       = card.querySelector('.vale-card-title');
    const promptText    = card.querySelector('.vale-prompt-text');
    const promptIcon    = card.querySelector('.vale-prompt-icon');
    const stampEl       = card.querySelector('.vale-stamp');

    if (isClaimed) {
      if (iconUnclaimed) iconUnclaimed.classList.add('hidden');
      if (iconClaimed)   iconClaimed.classList.remove('hidden');
      if (titleEl) {
        titleEl.style.textDecoration = 'line-through';
        titleEl.style.opacity = '0.5';
      }
      if (promptText) promptText.textContent = 'Canjeado ✨';
      if (promptIcon) promptIcon.style.opacity = '0';
      if (stampEl) {
        stampEl.style.opacity = '1';
        stampEl.style.transform = 'translate(-50%, -50%) rotate(-12deg) scale(1)';
      }
      card.style.borderColor = 'rgba(52, 211, 153, 0.4)';
      card.style.background  = 'rgba(16, 185, 129, 0.12)';

      // Confeti de estrellas/besos
      for (let i = 0; i < 15; i++) {
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-50 text-emerald-400';
        const rect = card.getBoundingClientRect();
        heart.style.left = `${rect.left + rect.width / 2 + (Math.random() - 0.5) * 140}px`;
        heart.style.top  = `${rect.top  + rect.height / 2 + (Math.random() - 0.5) * 140}px`;
        // Star SVG
        heart.innerHTML  = `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
        document.body.appendChild(heart);
        heart.animate([
          { transform: 'translate(0, 0) scale(1) rotate(0deg)', opacity: 1 },
          { transform: `translate(${(Math.random() - 0.5) * 200}px, ${-120 - Math.random() * 80}px) scale(1.6) rotate(${(Math.random() - 0.5) * 360}deg)`, opacity: 0 }
        ], { duration: 1200, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' });
        setTimeout(() => heart.remove(), 1200);
      }
    } else {
      if (iconUnclaimed) iconUnclaimed.classList.remove('hidden');
      if (iconClaimed)   iconClaimed.classList.add('hidden');
      if (titleEl) {
        titleEl.style.textDecoration = 'none';
        titleEl.style.opacity = '1';
      }
      if (promptText) promptText.textContent = 'Canjear Vale';
      if (promptIcon) promptIcon.style.opacity = '1';
      if (stampEl) {
        stampEl.style.opacity = '0';
        stampEl.style.transform = 'translate(-50%, -50%) rotate(-12deg) scale(1.5)';
      }
      card.style.borderColor = 'rgba(255, 255, 255, 0.08)';
      card.style.background  = 'transparent';
    }

    actualizarContadorVales();
  }

  function actualizarContadorVales() {
    const valesCards = document.querySelectorAll('.vale-card');
    const cumplidas = Array.from(valesCards).filter(c => c.classList.contains('vale-claimed')).length;
    const total = valesCards.length;
    
    const label = document.getElementById('vales-count-label');
    const fill  = document.getElementById('vales-bar-fill');
    
    if (label) {
      label.textContent = `${cumplidas} / ${total} vales canjeados`;
    }
    if (fill) {
      fill.style.width = `${(cumplidas / total) * 100}%`;
      if (cumplidas === total) {
        fill.classList.add('shadow-[0_0_15px_rgba(52,211,153,0.6)]');
      } else {
        fill.classList.remove('shadow-[0_0_15px_rgba(52,211,153,0.6)]');
      }
    }
  }
</script>
