];

const vales = [
  {
    tipo: "Válido 1 Uso",
    titulo: "Masaje Relajante",
    desc: "Válido por un masaje completo después de un día cansado, sin derecho a quejas de mi parte.",
    color: "purple"
  },
  {
    tipo: "Válido 1 Uso",
    titulo: "Cine en Casa",
