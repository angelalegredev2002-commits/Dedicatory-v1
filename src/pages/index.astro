<script define:vars={{ canciones, fotos, dedicatoria }}>

  // ───────────────────────────────────────────
  // DIBUJAR ROSAS, FLORES Y CORAZONES FLOTANTES CON LETRAS (EXCLUYE LA COMBI XO/OX)
  // ───────────────────────────────────────────
  const COLORES  = ['#f472b6','#c084fc','#fb7185','#818cf8','#f9a8d4','#fbbf24','#a78bfa','#e879f9'];
  const contenedor = document.getElementById('flotantes');

  function crearLetra() {
    const el = document.createElement('div');
    
    // 60% de probabilidades de renderizar un SVG premium de rosas/flores, 40% de letras y otros símbolos unicode
    const isSVG = Math.random() < 0.6;
    if (isSVG) {
      const svgs = [
        // Rosa vectorizada elegante con pétalo
        `<svg viewBox="0 0 24 24" class="w-6 h-6 fill-rose-500/25 drop-shadow-[0_0_8px_rgba(244,114,182,0.35)]"><path d="M12 2C9 2 4 6 4 11c0 5.25 4.5 9 8 9s8-3.75 8-9c0-5-5-9-8-9z"/></svg>`,
        // Flor silvestre delicada
        `<svg viewBox="0 0 24 24" class="w-5 h-5 fill-pink-500/20 drop-shadow-[0_0_8px_rgba(244,114,182,0.3)]"><path d="M12 2a3 3 0 00-3 3 3 3 0 00-3-3 3 3 0 00-3 3 3 3 0 003 3 3 3 0 00-3 3 3 3 0 003 3 3 3 0 003-3 3 3 0 003 3 3 3 0 003-3 3 3 0 00-3-3 3 3 0 003-3 3 3 0 00-3-3 3 3 0 00-3 3 3 3 0 00-3-3z"/></svg>`,
        // Corazón glowing
        `<svg viewBox="0 0 24 24" class="w-4 h-4 fill-rose-600/25 drop-shadow-[0_0_6px_rgba(244,114,182,0.35)]"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`,
        // Destello / Brillo
        `<svg viewBox="0 0 24 24" class="w-4 h-4 fill-purple-400/25 drop-shadow-[0_0_6px_rgba(168,85,247,0.3)]"><path d="M9.813 15.904L9 21l-.813-5.096L3.096 15.187 8.192 14.37 9 9.278l.808 5.093 5.096.817-5.091.816z"/></svg>`
      ];
      el.innerHTML = svgs[Math.floor(Math.random() * svgs.length)];
    } else {
      // Símbolos y letras puras: ¡Excluimos la x, o, X y O para prevenir cualquier combinación de "xo" u "ox"!
      const unicodeSymbols = [
        '✿', '❀', '⚘', '✨', '🍃', '★', '♡', '♥',
        'A','B','C','D','E','F','G','H','I','J','K','L','M','N','P','Q','R','S','T','U','V','W','Y','Z',
        'a','b','c','d','e','f','g','h','i','j','k','l','m','n','p','q','r','s','t','u','v','w','y','z'
      ];
      el.textContent = unicodeSymbols[Math.floor(Math.random() * unicodeSymbols.length)];
    }
    
    const dur   = Math.random() * 12 + 10;
    const delay = Math.random() * 3;
    el.style.cssText = `
      position:absolute;
      left:${Math.random() * 100}%;
      bottom:-60px;
      font-size:${Math.random() * 1.6 + 0.8}rem;
      color:${COLORES[Math.floor(Math.random() * COLORES.length)]};
      opacity:0;
      animation:floatUp ${dur}s ${delay}s linear forwards;
      pointer-events:none;
      user-select:none;
      transform: rotate(${Math.random() * 360}deg);
    `;
    contenedor.appendChild(el);
    setTimeout(() => el.remove(), (dur + delay + 1) * 1000);
  }

  // Primeras letras inmediatas
  for (let i = 0; i < 25; i++) crearLetra();
  setInterval(crearLetra, 350);


  // ───────────────────────────────────────────
  // CORAZONES FLOTANTES AL HACER CLIC EN CUALQUIER PARTE
  // ───────────────────────────────────────────
  document.addEventListener('click', (e) => {
    // Evitar disparar en botones, sobre de carta, enlaces, tarjetas de fotos o mapa de aventuras
    if (e.target.closest('button') || e.target.closest('a') || e.target.closest('.stack-card') || e.target.closest('.envelope-container') || e.target.closest('.adventure-card')) return;

    const heart = document.createElement('div');
    heart.className = 'fixed pointer-events-none z-50 text-purple-500/80';
    heart.style.left = `${e.clientX - 10}px`;
    heart.style.top = `${e.clientY - 10}px`;
    
    // SVG de corazón
    heart.innerHTML = `
      <svg class="w-6 h-6 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    `;
    
    document.body.appendChild(heart);

    // Animación personalizada vía JS Web Animations API
    const xOffset = (Math.random() - 0.5) * 120; // desplazamiento horizontal
    const keyframes = [
      { transform: 'translate(0, 0) scale(1)', opacity: 0.8 },
      { transform: `translate(${xOffset}px, -150px) scale(1.6)`, opacity: 0 }
    ];
    
    heart.animate(keyframes, {
      duration: 1200,
      easing: 'ease-out',
      fill: 'forwards'
    });

    setTimeout(() => heart.remove(), 1200);
  });


  // ───────────────────────────────────────────
  // REPRODUCTOR CON LETRAS SINCRONIZADAS
  // ───────────────────────────────────────────
  const audio        = document.getElementById('audio');
  const btnPlay      = document.getElementById('btn-play');
  const btnPrev      = document.getElementById('btn-prev');
  const btnNext      = document.getElementById('btn-next');
  const barraFill    = document.getElementById('barra-fill');
  const barraProg    = document.getElementById('barra-prog');
  const tActual      = document.getElementById('t-actual');
  const tTotal       = document.getElementById('t-total');
  const lyricDisplay = document.getElementById('lyric-display');
  const albumArt     = document.getElementById('album-art');
  const albumSvg     = document.getElementById('album-svg');
  const songTitle    = document.getElementById('song-title');
  const songArtist   = document.getElementById('song-artist');
  const songAlbum    = document.getElementById('song-album');
  const songSpotifyLink = document.getElementById('song-spotify-link');
  const playIconWrapper = document.getElementById('play-icon-wrapper');

  let idx     = 0;
  let playing = false;
  let ultimaLetra = '';

  const SVG_PLAY  = `<svg class="w-6 h-6 text-white translate-x-[2px]" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`;
  const SVG_PAUSE = `<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>`;

  function fmt(s) {
    if (!s || isNaN(s)) return '0:00';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${sec.toString().padStart(2,'0')}`;
  }

  function cargarCancion(i) {
    const c = canciones[i];
    audio.src   = c.src;
    songTitle.textContent  = c.titulo;
    songArtist.textContent = c.artista;
    if (songAlbum) songAlbum.textContent = c.album || '';
    if (songSpotifyLink && c.spotifyUrl) songSpotifyLink.href = c.spotifyUrl;

    if (c.cover) {
      albumArt.style.backgroundImage = `url(${c.cover})`;
      albumArt.style.backgroundSize  = 'cover';
      albumArt.style.backgroundPosition = 'center';
      albumSvg.style.display = 'none';
    } else {
      albumArt.style.backgroundImage = '';
      albumSvg.style.display = '';
    }
  }

  function actualizarLetra() {
    const c = canciones[idx];
    const t = audio.currentTime;
    let letra = c.letras[0]?.texto ?? '';
    for (const l of c.letras) {
      if (t >= l.t) letra = l.texto;
    }
    if (letra !== ultimaLetra) {
      ultimaLetra = letra;
      // Re-trigger animation
      lyricDisplay.classList.remove('lyric-line');
      void lyricDisplay.offsetWidth;
      lyricDisplay.classList.add('lyric-line');
      lyricDisplay.textContent = letra;
    }
  }

  function playTrack() {
    audio.play().catch(() => {});
    playIconWrapper.innerHTML = SVG_PAUSE;
    albumArt.classList.add('spinning', 'pulsing-beat');
    playing = true;
  }

  function pauseTrack() {
    audio.pause();
    playIconWrapper.innerHTML = SVG_PLAY;
    albumArt.classList.remove('spinning', 'pulsing-beat');
    playing = false;
  }

  btnPlay.addEventListener('click', () => {
    if (audio.paused) {
      playTrack();
    } else {
      pauseTrack();
    }
  });

  btnNext.addEventListener('click', () => {
    idx = (idx + 1) % canciones.length;
    cargarCancion(idx);
    if (playing) {
      playTrack();
    }
  });

  btnPrev.addEventListener('click', () => {
    if (audio.currentTime > 3) { audio.currentTime = 0; return; }
    idx = (idx - 1 + canciones.length) % canciones.length;
    cargarCancion(idx);
    if (playing) {
      playTrack();
    }
  });

  audio.addEventListener('timeupdate', () => {
    const pct = (audio.currentTime / audio.duration) * 100 || 0;
    barraFill.style.width = `${pct}%`;
    tActual.textContent   = fmt(audio.currentTime);
    tTotal.textContent    = fmt(audio.duration);
    actualizarLetra();
  });

  audio.addEventListener('ended', () => {
    idx = (idx + 1) % canciones.length;
    cargarCancion(idx);
    playTrack();
  });

  barraProg.addEventListener('click', (e) => {
    const rect = barraProg.getBoundingClientRect();
    audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
  });

  cargarCancion(0);


  // ───────────────────────────────────────────
  // INTERACCIÓN DE APERTURA DEL SOBRE DE CARTA
  // ───────────────────────────────────────────
  const sobre = document.getElementById('sobre');
  const sello = document.getElementById('sello');

  sobre.addEventListener('click', (e) => {
    e.stopPropagation(); // Evitar disparar corazones de fondo al abrir/cerrar la carta
    sobre.classList.toggle('open');
    if (sobre.classList.contains('open')) {
      sello.style.transform = 'scale(0) rotate(180deg)';
      sello.style.opacity = '0';
      // ¡AUTO-PLAY DE LA MÚSICA CON EFECTO DE BEAT AUTOMÁTICO AL ABRIR LA CARTA!
      if (audio.paused) {
        playTrack();
      }
    } else {
      sello.style.transform = 'scale(1) rotate(0deg)';
      sello.style.opacity = '1';
    }
  });


  // ───────────────────────────────────────────
  // CONTADOR DE TIEMPO TRANSCURRIDO (ANIVERSARIO)
  // ───────────────────────────────────────────
  const cDias  = document.getElementById('c-dias');
  const cHoras = document.getElementById('c-horas');
  const cMins  = document.getElementById('c-mins');
  const cSegs  = document.getElementById('c-segs');

  function actualizarContador() {
    const fechaInicio = new Date(dedicatoria.fechaInicio + 'T00:00:00');
    const ahora = new Date();
    const diferencia = ahora - fechaInicio;

    if (diferencia < 0) {
      cDias.textContent  = "00";
      cHoras.textContent = "00";
      cMins.textContent  = "00";
      cSegs.textContent  = "00";
      return;
    }

    const msPorDia   = 1000 * 60 * 60 * 24;
    const msPorHora  = 1000 * 60 * 60;
    const msPorMin   = 1000 * 60;
    const msPorSeg   = 1000;

    const dias  = Math.floor(diferencia / msPorDia);
    const horas = Math.floor((diferencia % msPorDia) / msPorHora);
    const mins  = Math.floor((diferencia % msPorHora) / msPorMin);
    const segs  = Math.floor((diferencia % msPorMin) / msPorSeg);

    cDias.textContent  = dias.toString().padStart(2, '0');
    cHoras.textContent = horas.toString().padStart(2, '0');
    cMins.textContent  = mins.toString().padStart(2, '0');
    cSegs.textContent  = segs.toString().padStart(2, '0');
  }

  actualizarContador();
  setInterval(actualizarContador, 1000);
</script>

<script is:inline>
  // ───────────────────────────────────────────
  // MANEJADOR DE AVENTURAS INTERACTIVAS CON GLOW EN EL CAMINO (MAPA DE RUTA)
  // ───────────────────────────────────────────
  function toggleAdventure(card) {
    card.classList.toggle('checked');
    const badge = card.querySelector('.adventure-badge');
    const row = card.closest('.adventure-path-row');
    
    if (card.classList.contains('checked')) {
      badge.textContent = "¡Lo logramos! ✦";
      if (row) {
        row.classList.add('checked-row');
      }
      
      // Efecto confeti de corazones al cumplir plan en su coordenada
      for (let i = 0; i < 15; i++) {
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-50 text-purple-500/80';
        
        // Centrar alrededor de la tarjeta
        const rect = card.getBoundingClientRect();
        heart.style.left = `${rect.left + rect.width/2 + (Math.random() - 0.5) * 100}px`;
        heart.style.top = `${rect.top + rect.height/2 + (Math.random() - 0.5) * 100}px`;
        
        heart.innerHTML = `
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
        `;
        
        document.body.appendChild(heart);
        
        const xOffset = (Math.random() - 0.5) * 200;
        const yOffset = -150 - Math.random() * 100;
        
        heart.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 0.9 },
          { transform: `translate(${xOffset}px, ${yOffset}px) scale(1.8)`, opacity: 0 }
        ], {
          duration: 1500,
          easing: 'ease-out',
          fill: 'forwards'
        });
        
        setTimeout(() => heart.remove(), 1500);
      }
    } else {
      badge.textContent = "Pendiente bonito ✦";
      if (row) {
        row.classList.remove('checked-row');
      }
    }
  }

  // --- Lógica del Carrusel de Fotos ---
  const carrusel = document.getElementById('foto-carrusel');
  const btnCarruselPrev = document.getElementById('btn-carrusel-prev');
  const btnCarruselNext = document.getElementById('btn-carrusel-next');
  const recuerdosCarrusel = document.getElementById('recuerdos-carrusel');
  const btnRecuerdosPrev = document.getElementById('btn-recuerdos-prev');
  const btnRecuerdosNext = document.getElementById('btn-recuerdos-next');
  const recuerdosCounter = document.getElementById('recuerdos-counter');

  if (recuerdosCarrusel && btnRecuerdosPrev && btnRecuerdosNext && recuerdosCounter) {
    const cards = Array.from(recuerdosCarrusel.querySelectorAll('.memory-banner'));

    const getCardStep = () => {
      const firstCard = cards[0];
      if (!firstCard) return 320;
      const styles = window.getComputedStyle(recuerdosCarrusel);
      const gap = parseFloat(styles.columnGap || styles.gap || '16');
      return firstCard.getBoundingClientRect().width + gap;
    };

    const updateRecuerdosState = () => {
      const step = getCardStep();
      const index = Math.max(0, Math.min(cards.length - 1, Math.round(recuerdosCarrusel.scrollLeft / step)));
      recuerdosCounter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      btnRecuerdosPrev.disabled = index === 0;
      btnRecuerdosNext.disabled = index >= cards.length - 1;
      btnRecuerdosPrev.style.opacity = btnRecuerdosPrev.disabled ? '0.45' : '1';
      btnRecuerdosNext.style.opacity = btnRecuerdosNext.disabled ? '0.45' : '1';
    };

    btnRecuerdosPrev.addEventListener('click', () => {
      recuerdosCarrusel.scrollBy({ left: -getCardStep(), behavior: 'smooth' });
    });

    btnRecuerdosNext.addEventListener('click', () => {
      recuerdosCarrusel.scrollBy({ left: getCardStep(), behavior: 'smooth' });
    });

    recuerdosCarrusel.addEventListener('scroll', updateRecuerdosState);
    window.addEventListener('resize', updateRecuerdosState);
    setTimeout(updateRecuerdosState, 120);
  }

  if (carrusel && btnCarruselPrev && btnCarruselNext) {
    const scrollAmount = 320; // Aproximadamente el ancho de una tarjeta
    
    // Función para actualizar estado de botones
    const updateButtons = () => {
      btnCarruselPrev.disabled = carrusel.scrollLeft <= 0;
      btnCarruselNext.disabled = Math.ceil(carrusel.scrollLeft) >= (carrusel.scrollWidth - carrusel.clientWidth - 10);
      
      btnCarruselPrev.style.opacity = btnCarruselPrev.disabled ? '0' : '';
      btnCarruselNext.style.opacity = btnCarruselNext.disabled ? '0' : '';
    };

    btnCarruselPrev.addEventListener('click', () => {
      carrusel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    btnCarruselNext.addEventListener('click', () => {
      carrusel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    carrusel.addEventListener('scroll', updateButtons);
    // Inicializar estado
    setTimeout(updateButtons, 100);
    window.addEventListener('resize', updateButtons);
  }

  // --- Lógica Vales Mágicos ---
  window.reclamarVale = function(elemento, mensaje) {
    if (elemento.classList.contains('canjeado')) return; // Ya canjeado
    
    // Animación del vale
    elemento.style.transform = 'scale(0.95)';
    setTimeout(() => {
      elemento.style.transform = 'scale(1)';
      elemento.style.opacity = '0.6';
      elemento.classList.add('canjeado');
      const btn = elemento.querySelector('button');
      if(btn) {
        btn.textContent = '¡CANJEADO!';
        btn.classList.add('bg-gray-500/50', 'text-gray-300');
        btn.classList.remove('bg-amber-500/20', 'bg-fuchsia-500/20', 'bg-emerald-500/20', 'bg-rose-500/20');
      }
    }, 150);

    // Disparar corazoncitos flotantes
    for(let i=0; i<15; i++) {
      setTimeout(() => {
        const heart = document.createElement('div');
        heart.className = 'fixed pointer-events-none z-50 text-rose-500';
        heart.style.left = '50%';
        heart.style.top = '50%';
        heart.innerHTML = `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
        document.body.appendChild(heart);
        const xOffset = (Math.random() - 0.5) * 400;
        const yOffset = (Math.random() - 0.5) * 400;
        heart.animate([
          { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
          { transform: `translate(calc(-50% + ${xOffset}px), calc(-50% + ${yOffset}px)) scale(0)`, opacity: 0 }
        ], { duration: 1000, easing: 'ease-out' });
        setTimeout(() => heart.remove(), 1000);
      }, i * 50);
    }

    // Mostrar Toast
    const toast = document.getElementById('toast-vale');
    const toastText = document.getElementById('toast-vale-text');
    if(toast && toastText) {
      toastText.textContent = mensaje;
      toast.classList.remove('opacity-0', 'translate-y-8');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-8');
      }, 3500);
    }
  };

  // --- Lógica Propuesta de Noviazgo ---
  const btnNo = document.getElementById('btn-no');
  const btnSi = document.getElementById('btn-si');
  const propuestaContent = document.getElementById('propuesta-content');
  const propuestaSuccess = document.getElementById('propuesta-success');
  const propuestaContainer = document.getElementById('propuesta-container');

  if (btnNo && btnSi) {
    // Hacer que el botón "No" huya del cursor
    const moveBtnNo = () => {
      const maxX = 150;
      const maxY = 100;
      
      const newX = (Math.random() - 0.5) * maxX * 2;
      const newY = (Math.random() - 0.5) * maxY * 2;
      
      btnNo.style.position = 'absolute';
      btnNo.style.transform = `translate(${newX}px, ${newY}px)`;
    };

    btnNo.addEventListener('mouseover', moveBtnNo);
    btnNo.addEventListener('touchstart', moveBtnNo);

    // Cuando dice que SÍ
    btnSi.addEventListener('click', () => {
      // Ocultar la pregunta
      propuestaContent.style.display = 'none';
      
      // Mostrar el mensaje de éxito
      propuestaSuccess.classList.remove('hidden');
      propuestaSuccess.classList.add('flex');
      
      // Cambiar fondo del contenedor
      propuestaContainer.classList.add('bg-rose-900/40', 'border-rose-500/50');
      
      // Animación de aparición
      setTimeout(() => {
        propuestaSuccess.classList.remove('opacity-0');
        propuestaSuccess.classList.add('opacity-100');
      }, 50);

      // Lluvia de corazones explosiva
      for(let i=0; i<60; i++) {
        setTimeout(() => {
          const heart = document.createElement('div');
          heart.className = 'fixed pointer-events-none z-50 text-rose-500';
          heart.style.left = '50%';
          heart.style.top = '50%';
          heart.innerHTML = `<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
          document.body.appendChild(heart);
          
          const angle = Math.random() * Math.PI * 2;
          const velocity = 100 + Math.random() * 500;
          const xOffset = Math.cos(angle) * velocity;
          const yOffset = Math.sin(angle) * velocity;
          
          heart.animate([
            { transform: 'translate(-50%, -50%) scale(0.5) rotate(0deg)', opacity: 1 },
            { transform: `translate(calc(-50% + ${xOffset}px), calc(-50% + ${yOffset}px)) scale(2) rotate(${Math.random() * 360}deg)`, opacity: 0 }
          ], { duration: 1500 + Math.random() * 1500, easing: 'cubic-bezier(0.25, 1, 0.5, 1)' });
          
          setTimeout(() => heart.remove(), 3000);
        }, i * 20);
      }
    });
  }
</script>
