---
import Layout from '../layouts/Layout.astro';

// ══════════════════════════════════════════════
// PERSONALIZA AQUÍ TU DEDICATORIA
// ══════════════════════════════════════════════

const dedicatoria = {
  para: "Lesli",                        // Nombre de la persona
  de:   "Con todo mi corazón",
  mensaje: `Hay palabras que a veces no sé cómo expresar, pero hoy quiero intentarlo desde lo más profundo de mi ser. Me enamoré de ti completamente, de una manera que nunca creí posible, y quiero serte siempre leal.

Me encanta absolutamente todo de ti. Me encantan tus caricias que me dan paz, tu mirada, tu forma de ser, y hasta cuando te pones "celosita" te ves hermosa. Existen mil y un formas de decirte que te amo, y quiero pasar mi vida demostrártelas todas.

Quizá a veces no sea el hombre más detallista, ni el caballero perfecto que dicen las historias, pero soy alguien muy humilde que te entrega su alma entera sin dudarlo. Alguien que haría lo que fuera solo por cuidarte y verte feliz.

Gracias por existir, gracias por quedarte a mi lado. Te amo infinitamente.`,
  // Pon la fecha de vuestro aniversario o fecha especial aquí (Formato: AAAA-MM-DD)
  fechaInicio: "2026-04-18", 
};

const playlistPhoto = "/images/record/image.png";

// Canciones: 3AM - Sirena
const canciones = [
  {
    titulo:  "Sirena",
    artista: "3AM",
    src:     "/music/sirena_3am.mp3",
    cover:   playlistPhoto,
    album:   "Nuestra playlist infinita",
    spotifyUrl: "https://open.spotify.com/search/Sirena%203AM",
    letras: [
      { t: 0,   texto: "..." },
      { t: 5,   texto: "🎶 Disfruta la canción... 🎶" }
    ],
  },
];

// Fotos: coloca los archivos en /public/fotos/
const fotos: string[] = [];

const hitosCamino = [
  {
    fecha: "18 de abril de 2026",
    titulo: "El inicio de lo nuestro",
    desc: "La fecha que siempre va a tener un brillo especial porque ahi comenzo esta historia tan bonita entre nosotros."
  },
  {
    fecha: "14 de junio de 2026",
    titulo: "Primer detalle",
    desc: "Ese gesto que se quedo guardado en mi corazon y me hizo sonreir como si el tiempo se hubiera detenido."
  },
  {
    fecha: "15 de junio de 2026",
    titulo: "Primera tarde juntos",
    desc: "Una tarde para recordar despacito, de esas que se quedan pegadas al alma por lo bonita que fue."
  },
  {
    fecha: "Lo que sigue",
    titulo: "Mas capitulos contigo",
    desc: "Todo esto apenas empieza y todavia nos faltan mil historias, salidas, abrazos y locuras por vivir."
  }
];

const recuerdos = [
  { codigo: "7.0", titulo: "Primera mirada", fecha: "", desc: "Ese segundo en el que todo cambio y aparecio esa chispa que ya no se fue.", imagen: "/images/record/image copy.png" },
  { codigo: "7.1", titulo: "Primer abrazo", fecha: "", desc: "El momento exacto en que tus brazos se sintieron como mi lugar favorito.", imagen: "/images/record/image copy 2.png" },
  { codigo: "7.2", titulo: "Primera salida", fecha: "", desc: "Nuestra primera aventura juntos, con nervios bonitos y sonrisas que lo dijeron todo.", imagen: "/images/record/image copy 3.png" },
  { codigo: "7.3", titulo: "Primer beso", fecha: "", desc: "El beso que hizo que el mundo se quedara callado por un instante solo para nosotros.", imagen: "/images/record/image copy 4.png" },
  { codigo: "7.4", titulo: "Primera cena", fecha: "", desc: "Compartir la mesa contigo hizo que hasta lo mas simple se sintiera especial.", imagen: "/images/record/image copy.png" },
  { codigo: "7.5", titulo: "Primera matcha juntos", fecha: "", desc: "Una escena que me encanta recordar porque tu amor por el matcha tambien se volvio parte de mis recuerdos favoritos.", imagen: "/images/record/image copy 2.png" },
  { codigo: "7.6", titulo: "Primera pelea", fecha: "48 horas sin dormir", desc: "Hasta los momentos dificiles me enseñan cuanto vales para mi y cuanto quiero aprender a cuidarnos mejor.", imagen: "/images/record/image copy 3.png" },
  { codigo: "7.7", titulo: "Primera noche con un Four Loko", fecha: "", desc: "Una historia caotica, divertida y tan nuestra que siempre me sacara una sonrisa.", imagen: "/images/record/image copy 4.png" },
  { codigo: "7.8", titulo: "Primer detalle", fecha: "14/06/2026", desc: "Ese detalle quedo marcado como una prueba bonita de todo lo que estamos construyendo.", imagen: "/images/record/image copy.png" },
  { codigo: "7.9", titulo: "Primera tarde juntos", fecha: "15/06/2026", desc: "Una tarde completa contigo que guardo como un tesoro porque se sintio suave, bonita y muy nuestra.", imagen: "/images/record/image copy 2.png" }
];

const locuras = [
  {
    titulo: "Ir juntos a la playa",
    nota: "Aun no hemos ido juntos a la playa",
    desc: "Quiero verte con el viento en el cabello, caminar contigo por la orilla y quedarnos hasta que caiga la tarde."
  },
  {
    titulo: "Ir juntos a un karaoke",
    nota: "Ella ama el karaoke",
    desc: "Todavia no hemos ido, asi que nos debemos una noche cantando fuerte, riendonos y robandonos el microfono."
  },
  {
    titulo: "Llevarte a Rustica Barranco",
    nota: "Una noche cerquita a la playa",
    desc: "Ese plan pendiente tiene toda la vibra de una salida larga, rica y con vista a una noche que no queramos terminar."
  },
  {
    titulo: "Cena en el Museo Larco Herrera",
    nota: "Una cita pendiente y preciosa",
    desc: "Una cena contigo en un lugar asi de bonito suena a recuerdo importante desde antes de vivirlo."
  }
];

const razones = [
  {
    titulo: "Tu sonrisa",
    desc: "Porque cada vez que sonries haces que todo alrededor se sienta un poquito mas bonito.",
    color: "fuchsia"
  },
  {
    titulo: "Tu mirada",
    desc: "Porque cuando me miras asi, siento que no necesito nada mas para estar bien.",
    color: "purple"
  },
  {
    titulo: "Tus abrazos",
    desc: "Porque en tus abrazos encuentro calma, hogar y una paz que no se parece a ninguna otra.",
    color: "rose"
  },
  {
    titulo: "Tu amor por el karaoke",
    desc: "Porque imaginarte cantando feliz me da ganas de acompañarte siempre en todas tus canciones.",
    color: "emerald"
  },
  {
    titulo: "Tu lado matcha",
    desc: "Porque hasta tus gustos mas pequenos, como ese amor por el matcha, me parecen adorables y tan tuyos.",
    color: "amber"
  },
  {
    titulo: "Tu manera de querer",
    desc: "Porque amas con intensidad, con verdad y con ese corazon enorme que me enamora cada dia mas.",
    color: "pink"
  }
];
---

<Layout title={`Para ${dedicatoria.para}`} description="Una dedicatoria especial con amor">

  <!-- ══ FONDO: Letras flotantes ══ -->
  <div id="flotantes" class="fixed inset-0 overflow-hidden pointer-events-none z-0"></div>

  <!-- ══ HERO ══ -->
  <section class="relative z-10 flex min-h-[78vh] flex-col items-center justify-center px-6 pt-20 pb-12 text-center md:min-h-[88vh]">
    <p class="text-purple-400 text-[11px] font-light tracking-[0.38em] uppercase mb-4 flex items-center gap-2 justify-center">
      <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 4.8 5.6.8-4 4 1 5.4-5-2.8-5 2.8 1-5.4-4-4 5.6-.8z"/></svg>
      Un rinconcito de amor solo para ti
      <svg class="w-4 h-4 animate-pulse" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l2.4 4.8 5.6.8-4 4 1 5.4-5-2.8-5 2.8 1-5.4-4-4 5.6-.8z"/></svg>
    </p>
    <h1 class="glow-text font-black leading-[0.95] mb-4 flex flex-col items-center justify-center">
      <span class="text-white text-4xl md:text-6xl mb-2">Para ti, mi amor</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-fuchsia-400 to-pink-400 text-6xl md:text-[8rem] leading-none">
        {dedicatoria.para}
      </span>
    </h1>
    <p class="max-w-2xl text-sm md:text-base text-gray-300 leading-relaxed">
      Ordene este espacio para que cada parte de nosotros se sienta mas cerquita: la carta, la melodia, nuestros recuerdos y todo lo que todavia nos falta vivir.
    </p>
    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs uppercase tracking-[0.25em] text-gray-200">
        {dedicatoria.de}
      </span>
      <span class="rounded-full border border-fuchsia-500/20 bg-fuchsia-500/10 px-4 py-2 text-xs uppercase tracking-[0.25em] text-fuchsia-200">
        Desde el {hitosCamino[0].fecha}
      </span>
    </div>

    <div class="mt-12 flex flex-col items-center gap-2 text-gray-500 text-sm animate-bounce">
      <span>Desliza hacia abajo pliss</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- ══ MENSAJE CON SOBRE INTERACTIVO ══ -->
  <section class="relative z-10 py-20 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
      
      <p class="text-purple-400 text-sm font-semibold tracking-widest uppercase mb-8 text-center">
        Tengo una cartita guardada para ti... ¿la abres, pliss? ✨
      </p>

      <div class="envelope-container w-full flex justify-center pb-[18rem] md:pb-[20rem] pt-8 md:pt-12">
        <div id="sobre" class="envelope flex items-center justify-center">
          
          <!-- Flap (tapa) del sobre -->
          <div class="envelope-flap"></div>
          
          <!-- Pocket (bolsillo frontal) del sobre -->
          <div class="envelope-pocket"></div>
          
          <!-- Sello lacrado del sobre (Corazón SVG en el centro) -->
          <div id="sello" class="absolute z-10 transition-all duration-500 flex items-center justify-center bg-gray-900 border border-white/20 w-14 h-14 rounded-full shadow-lg">
            <svg class="w-7 h-7 text-purple-500 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>

          <!-- Carta que desliza hacia arriba -->
          <div class="envelope-letter">
            <div class="grid gap-5 md:grid-cols-[170px_1fr] md:items-start">
              <div class="overflow-hidden rounded-[24px] border border-white/10 bg-black/30 shadow-lg">
                <img src="/images/carta-recuerdo.svg" alt="Recuerdo decorativo de la carta" class="h-44 w-full object-cover" loading="lazy" />
                <div class="px-4 py-3 text-left">
                  <p class="text-[10px] uppercase tracking-[0.28em] text-purple-300">Nuestra carta</p>
                  <p class="mt-2 text-sm text-gray-200 leading-relaxed">Una imagen chiquita para guardar este pedacito de nosotros dentro de la carta.</p>
                </div>
              </div>
              <div class="text-left">
                <span class="text-purple-400 text-2xl mb-3 block font-serif">❝</span>
                <p class="text-gray-200 text-sm md:text-base leading-relaxed whitespace-pre-line italic font-serif">
                  {dedicatoria.mensaje}
                </p>
                <span class="text-purple-400 text-2xl mt-3 block font-serif">❞</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- ══ LÍNEA DEL TIEMPO DE NUESTROS MOMENTOS ══ -->
  <section class="relative z-10 py-10 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-white text-center mb-4 flex items-center justify-center gap-3">
        <!-- SVG History icon -->
        <svg class="w-7 h-7 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        El camino que estamos dibujando...
      </h2>
      <p class="text-gray-400 text-center mb-10 text-sm max-w-2xl mx-auto">
        Lo compacte para que el recorrido se lea mas rapido y con una jerarquia mas clara entre fecha, recuerdo y lo que sentimos en cada etapa.
      </p>
      <div class="grid gap-3 md:grid-cols-2">
        {hitosCamino.map((hito, index) => (
          <article class="rounded-[24px] border border-white/10 bg-white/5 p-4 md:p-5 backdrop-blur-xl shadow-xl">
            <div class="mb-3 flex items-center justify-between gap-3">
              <span class:list={[
                "inline-flex h-9 w-9 items-center justify-center rounded-full text-xs font-bold",
                index === 0 && "bg-purple-500/20 text-purple-200",
                index === 1 && "bg-rose-500/20 text-rose-200",
                index === 2 && "bg-fuchsia-500/20 text-fuchsia-200",
                index === 3 && "bg-indigo-500/20 text-indigo-200"
              ]}>
                0{index + 1}
              </span>
              <time class="text-[10px] uppercase tracking-[0.22em] text-gray-400">{hito.fecha}</time>
            </div>
            <h3 class="text-white text-lg font-bold leading-tight">{hito.titulo}</h3>
            <p class="text-gray-300 text-[13px] mt-2 leading-relaxed">{hito.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══ CONTADOR DE TIEMPO PREMIUM ══ -->
  <section class="relative z-10 py-10 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-[26px] p-3 md:p-4 shadow-2xl">
        <div class="flex flex-col gap-3 md:flex-row md:items-stretch">
          <div class="md:w-48 rounded-[20px] border border-white/10 bg-black/30 p-4 flex items-center gap-3 md:flex-col md:items-start md:justify-between">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-500/15 text-purple-300">
              <svg class="w-6 h-6 animate-spin-slow" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="text-left">
              <p class="text-[10px] uppercase tracking-[0.3em] text-purple-300">Tiempo</p>
              <h3 class="mt-1.5 text-white text-base font-bold">Lo que ya vivimos juntitos</h3>
              <p class="mt-1.5 text-[13px] text-gray-400 leading-relaxed">Ahora esta mas compacto y con el reloj acomodado al costado izquierdo.</p>
            </div>
          </div>
          <div class="grid flex-1 grid-cols-2 md:grid-cols-4 gap-2.5 text-center">
          <div class="bg-black/30 border border-white/5 rounded-[18px] p-2.5">
            <span id="c-dias" class="text-[1.7rem] md:text-[2.2rem] font-extrabold text-white glow-text">00</span>
            <p class="text-gray-400 text-[10px] mt-1 uppercase tracking-wider font-light">Días</p>
          </div>
          <div class="bg-black/30 border border-white/5 rounded-[18px] p-2.5">
            <span id="c-horas" class="text-[1.7rem] md:text-[2.2rem] font-extrabold text-white glow-text">00</span>
            <p class="text-gray-400 text-[10px] mt-1 uppercase tracking-wider font-light">Horas</p>
          </div>
          <div class="bg-black/30 border border-white/5 rounded-[18px] p-2.5">
            <span id="c-mins" class="text-[1.7rem] md:text-[2.2rem] font-extrabold text-white glow-text">00</span>
            <p class="text-gray-400 text-[10px] mt-1 uppercase tracking-wider font-light">Min</p>
          </div>
          <div class="bg-black/30 border border-white/5 rounded-[18px] p-2.5">
            <span id="c-segs" class="text-[1.7rem] md:text-[2.2rem] font-extrabold text-white glow-text">00</span>
            <p class="text-gray-400 text-[10px] mt-1 uppercase tracking-wider font-light">Seg</p>
          </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ REPRODUCTOR ══ -->
  <section class="relative z-10 py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-white text-center mb-4 flex items-center justify-center gap-3">
        <!-- SVG Note Icon -->
        <svg class="w-8 h-8 text-fuchsia-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 10l12-3M9 14a3 3 0 11-6 0 3 3 0 016 0zm12 2a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        Nuestra melodía favorita
      </h2>
      <p class="text-gray-400 text-center mb-10 text-sm max-w-2xl mx-auto">
        Cambie esta parte a una vibra mas cercana a Spotify, con portada, mini album, enlace directo y una imagen especial junto a Lesi.
      </p>

      <div class="relative overflow-hidden rounded-[28px] border border-white/10 bg-[#08130d]/95 p-4 md:p-6 shadow-2xl backdrop-blur-xl">
        <div class="relative z-10">
        <div class="mb-4 flex flex-col gap-3 rounded-[24px] border border-white/10 bg-white/5 px-4 py-3 md:flex-row md:items-center md:justify-between">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#1ed760]/16 text-[#1ed760]">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 1.5C6.201 1.5 1.5 6.201 1.5 12S6.201 22.5 12 22.5 22.5 17.799 22.5 12 17.799 1.5 12 1.5Zm4.818 15.104a.748.748 0 0 1-1.03.247c-2.821-1.724-6.372-2.114-10.556-1.159a.75.75 0 0 1-.334-1.462c4.58-1.046 8.503-.604 11.673 1.333a.75.75 0 0 1 .247 1.041Zm1.471-3.272a.936.936 0 0 1-1.287.309c-3.229-1.985-8.148-2.562-11.968-1.404a.938.938 0 0 1-.543-1.795c4.368-1.326 9.795-.69 13.493 1.584a.938.938 0 0 1 .305 1.306Zm.126-3.408c-3.873-2.301-10.269-2.513-13.966-1.39a1.125 1.125 0 1 1-.652-2.153c4.249-1.287 11.314-1.037 15.767 1.607a1.125 1.125 0 1 1-1.149 1.936Z"/>
              </svg>
            </div>
            <div>
              <p class="text-[11px] uppercase tracking-[0.3em] text-[#1ed760]">Spotify mode</p>
              <p class="text-white text-sm md:text-base font-semibold">Nuestra cancion con una portada hecha para nosotros</p>
            </div>
          </div>
          <a
            id="song-spotify-link"
            href={canciones[0].spotifyUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-[#1ed760] px-4 py-2.5 text-sm font-bold text-[#07130a] transition-transform hover:scale-[1.02]"
          >
            Abrir en Spotify
          </a>
        </div>

        <div class="grid gap-4 md:grid-cols-[210px_1fr] md:items-start">
          <div class="overflow-hidden rounded-[24px] border border-white/10 bg-black/30 shadow-xl">
            <img src="/images/melodia-juntos.svg" alt="Ilustración romántica para la melodía favorita" class="h-full w-full object-cover" loading="lazy" />
          </div>

          <div
            class="relative overflow-hidden rounded-[24px] border border-white/10 bg-[#0a1510]/80 p-4 md:p-5 shadow-xl"
            style={`background-image: linear-gradient(140deg, rgba(6, 12, 10, 0.92), rgba(10, 21, 16, 0.86) 40%, rgba(6, 12, 10, 0.94)), url('${playlistPhoto}'); background-size: cover; background-position: center;`}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-black/44 via-[#08130d]/18 to-black/68 pointer-events-none"></div>
            <div class="absolute inset-0 backdrop-blur-[1.5px] pointer-events-none"></div>
            <div class="relative z-10 mb-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-start">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                <div id="album-art"
                  class="w-28 h-28 md:w-32 md:h-32 rounded-[22px] shadow-2xl flex items-center justify-center overflow-hidden
                        bg-gradient-to-br from-emerald-500 via-green-500 to-lime-400 relative transition-transform duration-500 shrink-0">
                  <!-- SVG Music Icon inside Album -->
                  <svg id="album-svg" class="w-16 h-16 text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 10l12-3M9 14a3 3 0 11-6 0 3 3 0 016 0zm12 2a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>

                <div class="text-left">
                  <p class="text-[11px] uppercase tracking-[0.3em] text-[#1ed760]">Playlist de nosotros</p>
                  <p class="text-white text-xl md:text-2xl font-bold font-sans mt-1.5" id="song-title">Cargando...</p>
                  <p class="text-gray-300 text-sm mt-1" id="song-artist"></p>
                  <p class="text-gray-500 text-sm mt-1.5" id="song-album">{canciones[0].album}</p>
                  <p class="text-gray-300/90 text-[13px] mt-3 leading-relaxed max-w-xl">
                    Esta seccion ahora lleva la foto de ustedes dentro de la playlist, como si fuera una mini portada especial conectada a su cancion.
                  </p>
                </div>
              </div>

              <div class="relative overflow-hidden rounded-[22px] border border-white/12 bg-black/30 shadow-2xl min-h-[220px]">
                <img
                  src={playlistPhoto}
                  alt="Foto especial de ustedes dentro de la playlist"
                  loading="lazy"
                  class="h-full w-full object-cover"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
                />
