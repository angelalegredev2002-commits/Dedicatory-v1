                index % 5 === 0 && "bg-gradient-to-br from-[#12061a] via-[#22113b] to-[#4a154b]",
                index % 5 === 1 && "bg-gradient-to-br from-[#0d1522] via-[#1a2740] to-[#3f1a53]",
                index % 5 === 2 && "bg-gradient-to-br from-[#1a0d22] via-[#35133c] to-[#5b1b3b]",
                index % 5 === 3 && "bg-gradient-to-br from-[#12131f] via-[#231c3d] to-[#283d63]",
                index % 5 === 4 && "bg-gradient-to-br from-[#181115] via-[#2d1632] to-[#5a1d63]"
              ]}
            >
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(255,255,255,0.18),transparent_28%),radial-gradient(circle_at_bottom_left,rgba(244,114,182,0.12),transparent_34%)]"></div>
              <div class="absolute right-4 top-3 text-[4.2rem] font-black leading-none text-white/8 select-none">
